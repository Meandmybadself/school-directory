{
  // Pages Functions run on the Workers runtime, not in a browser, so they need
  // Cloudflare's globals instead of the DOM lib the SPA's tsconfig pulls in.
  // Separate project rather than a second `include`, because the two type
  // environments genuinely conflict.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "paths": {
      "@sd/shared": ["../../packages/shared/src/index.ts"],
      "@sd/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["functions"]
}
